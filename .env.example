# Set both values in Vercel Environment Variables. Basic Auth is skipped outside Vercel.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# SitecoreAI connection values from Deploy > Environment > Developer Settings.
NEXT_PUBLIC_DEFAULT_SITE_NAME=
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
SITECORE_EDGE_CONTEXT_ID=
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=
SITECORE_EDITING_SECRET=

# Optional Design Library connection.
SITECORE_AUTH_CLIENT_ID=
SITECORE_AUTH_CLIENT_SECRET=
SITECORE_RENDERINGHOST_NAME=